---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const labs = await getCollection("labs", (l) => l.data.status === "available" && l.data.steps.length > 0);
  return labs.map((lab) => ({ params: { id: lab.id }, props: { lab } }));
}

const { lab } = Astro.props;
const d = lab.data;
const CAT: Record<string, [string, string]> = {
  switching: ["Switching", "blue"], routing: ["Routing", "accent"], services: ["خدمات الشبكة", "brown"],
  linux: ["سيرفرات Linux", "green"], vpn: ["VPN و Docker", "blue"],
};
// Links in YAML that start with "/" are site paths: prefix the deploy base
const data = structuredClone(d);
if (data.summary?.short?.href.startsWith("/")) data.summary.short.href = url(data.summary.short.href);
---
<Base title={`${d.title} | مختبر | ${site.name}`} description={d.steps[0]?.idea.slice(0, 150)}>
  <p class="hint" style="margin-block:22px 0"><a href={url("labs/")}>مكتبة المختبرات</a> ← {d.title}</p>
  <article class="lv" aria-label={d.title} style="margin-top:12px">
    <div class="lv-head">
      <h1 style="font-size:1.6rem">{d.title}</h1>
      <div class="lv-meta">
        <span class="chip"><i style={`background:var(--${CAT[d.category][1]})`}></i>{CAT[d.category][0]}</span>
        <span class="chip">{d.level}</span>
        <span class="chip">{d.minutes} دقيقة</span>
        {d.platform && <span class="chip">{d.platform}</span>}
        {d.devices && <span class="chip">{d.devices}</span>}
      </div>
      <div class="progress" aria-hidden="true"><span id="lvProg"></span></div>
      <nav class="stepper" id="stepper" aria-label="خطوات المختبر"></nav>
    </div>
    <div class="lv-body">
      <div class="lv-diagram">
        <div class="v-scroll"><svg id="vSvg" role="img" aria-label={`مخطط مختبر ${d.title}`}></svg></div>
        {d.legend.length > 0 && (
          <div class="legend">
            {d.legend.map((l) => <span><i style={`background:var(--${l.color})`}></i>{l.label}</span>)}
          </div>
        )}
        <div class="ping-box" id="pingBox" hidden>
          <h4 id="pingTitle" style="margin:0;font-size:.85rem;color:var(--muted)"></h4>
          <div class="ping-btns" id="pingBtns"></div>
          <pre class="out" id="pingOut">_</pre>
        </div>
      </div>
      <div class="lv-steps" id="lvSteps"></div>
    </div>
  </article>
  <script id="lab-data" type="application/json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</Base>

<script>
  import "../../scripts/lab-viewer.js";
</script>
