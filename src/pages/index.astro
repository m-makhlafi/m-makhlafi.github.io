---
import Base from "../layouts/Base.astro";
import NetLab from "../components/NetLab.astro";
import LabCatalog from "../components/LabCatalog.astro";
import { site } from "../data/site";
import { racks, projects, series, shorts, platforms, changelog } from "../data/portfolio";
import { url } from "../lib/url";
import { floors } from "../data/journey";
import { getCollection } from "astro:content";

const seriesById = Object.fromEntries(series.map((s) => [s.id, s]));
const unitByName = Object.fromEntries(racks.flatMap((r) => r.units).map((u) => [u.name, u]));
const labCount = (await getCollection("labs")).length;
// every number is counted from the site's own data or taken from his story
const stats = [
  { n: "2020", t: "بداية دراسة تقنية المعلومات" },
  { n: String(projects.length), t: "مشاريع على GitHub" },
  { n: String(labCount), t: "مختبراً تفاعلياً بأوامره" },
  { n: String(shorts.filter((v) => v.video).length), t: "فيديو قصير بالعربية" },
];
---
<Base>
  <!-- HERO -->
  <section class="hero" id="top">
    <div>
      <span class="eyebrow rise"><i class="led pulse"></i>status: open to work · {site.heroIp}</span>
      <p class="hero-name rise d1">{site.name}</p>
      <h1 class="rise d1">مهندس <em>برمجيات</em><br />و<span class="u">مدير أنظمة</span></h1>
      <p class="lead rise d2">{site.hero.lead}</p>
      <div class="cta rise d3">
        <a class="btn primary" href={url("journey/")}>ادخل رحلتي ثلاثية الأبعاد</a>
        <a class="btn" href="#contact">تواصل معي</a>
      </div>
      <p class="hero-note rise d4">{site.hero.note}</p>
    </div>

    <div class="console rise d2" aria-label="رسم متحرك لشبكة منزلية وطرفية">
      <div class="console-bar">
        <span class="dots"><i></i><i></i><i></i></span>
        <span>network-topology — simulation</span>
        <span id="pktCount">0 pkts</span>
      </div>
      <canvas id="topo" role="img" aria-label="مخطط شبكة: الإنترنت، راوتر، سويتش، سيرفرين، وحدة تخزين، وجهاز محمول، تنتقل بينها حزم بيانات ملونة"></canvas>
      <div class="term"><span class="p">{site.handle}@lab:~$</span> <span class="c">ssh admin@srv-01</span>
<span class="ok">Welcome to Ubuntu 24.04 LTS (GNU/Linux 6.8 x86_64)</span>
<span class="p">admin@srv-01:~$</span> <span class="c">ping -c 3 10.0.0.1</span>
<span id="pingLines">64 bytes from 10.0.0.1: icmp_seq=1 ttl=64 time=0.42 ms</span></div>
    </div>
  </section>

  <dl class="stats" aria-label="بالأرقام">
    {stats.map((s) => <div><dt>{s.t}</dt><dd>{s.n}</dd></div>)}
  </dl>

  <!-- WHAT I OFFER -->
  <section class="block" id="offer">
    <div class="sec-head">
      <span class="port">:8080 stack</span>
      <h2>ماذا أقدّم</h2>
      <p>أربعة مسارات أعمل فيها، ولكل مسار دليل تستطيع فتحه بنفسك.</p>
    </div>
    <div class="offer">
      {site.offer.map((o, i) => (
        <article class="offer-card" style={`--wire:var(--${o.color})`}>
          <div class="offer-top"><span class="mono">0{i + 1} /</span><span class="mono">{o.port}</span></div>
          <h3>{o.label}</h3>
          <p>{o.line}</p>
          <ul>
            {o.units.map((n) => {
              const u = unitByName[n];
              return u && <li><b>{u.name}</b><small>{u.note}</small></li>;
            })}
          </ul>
          <a class="offer-proof" href={o.proof.href.startsWith("#") ? o.proof.href : url(o.proof.href)}>{o.proof.label} ←</a>
        </article>
      ))}
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="block" id="experience">
    <div class="sec-head">
      <span class="port">CHANGELOG.md</span>
      <h2>الخبرة</h2>
      <p>من مقاعد الجامعة عام 2020 إلى فريق هندسة البرمجيات في سما تاكسي، مكتوبة بأسلوب سجل الإصدارات: كل محطة إصدار جديد.</p>
    </div>
    <div class="xp">
      <div class="log">
        {changelog.map((e) => (
          <div class="entry" style={`--wire:var(--${e.color})`}><span class="ver">{e.ver}</span><div><h3>{e.title}</h3><p>{e.text}</p></div></div>
        ))}
      </div>
      <aside class="xp-aside">
        <dl class="spec-list">
          {site.about.specs.map((s) => (
            <div><dt>{s.k}</dt><dd class={s.open ? "open-to-work" : undefined}>{s.open && <i class="led pulse"></i>}{s.v}</dd></div>
          ))}
        </dl>
        <a class="jr-teaser" href={url("journey/")}>
          <span class="floors" aria-hidden="true">
            {[...floors].reverse().map((f) => <i style={`--c:var(--${f.color})`}></i>)}
          </span>
          <span>
            <h3>نفس القصة، ثلاثية الأبعاد</h3>
            <p>برج من {floors.length} طوابق: الكابلات والكاميرات، والشبكات، والسيرفرات، والكود، وتصميم الأنظمة.</p>
          </span>
          <span class="btn primary">ادخل ←</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="block" id="projects">
    <div class="sec-head">
      <span class="port">:80 http</span>
      <h2>المشاريع</h2>
      <p>مشاريعي على GitHub. بعضها منتجات كودها المصدري خاص وتُعرض تفاصيلها عند الطلب، وبعضها قيد البناء وأنشر خطتها أولاً ثم الكود على مراحل.</p>
    </div>
    <div class="projects">
      {projects.map((p) => (
        <article class="proj" style={`--wire:var(--${p.color})`}>
          <div class="proj-top"><span class="mono">{p.path}</span><span class={p.status === "production" ? "pill" : "pill wip"}>{p.status === "production" ? "● production" : "◐ building in public"}</span></div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
          <a class="proj-try" href={p.href} target="_blank" rel="noopener">عرض على GitHub ←</a>
          <div class="proj-foot"><span>{p.footL}</span><span>source <b>{p.status === "production" ? "private" : "in progress"}</b></span></div>
        </article>
      ))}
    </div>
    <p class="hint" style="margin-top:14px"><a href="https://github.com/m-makhlafi" target="_blank" rel="noopener">كل المستودعات على GitHub ←</a></p>
  </section>

  <NetLab />

  <!-- LAB LIBRARY: part of the lab section above, not a section of its own -->
  <div class="sub-block" id="labs">
    <div class="sub-head">
      <span class="port">:69 tftp</span>
      <h3>مكتبة المختبرات</h3>
      <p>بعد المحاكاة، كل موضوع مختبر مستقل: كيف يعمل، وكل أمر يُستخدم لضبطه، وكيف تتحقق أنه يعمل.</p>
    </div>
    <LabCatalog />
  </div>

  <!-- CONTENT -->
  <section class="block" id="content">
    <div class="sec-head">
      <span class="port">:443 https</span>
      <h2>المحتوى القصير</h2>
      <p>الموسم الأول: 30 فيديو في أربع سلاسل. اضغط أي بطاقة لتشاهد الفيديو، ولون البطاقة يحدد السلسلة التي تنتمي لها.</p>
    </div>
    <div class="shorts-filter" id="shortsFilter" role="group" aria-label="تصفية حسب السلسلة">
      <button type="button" data-f="all" aria-pressed="true">الكل</button>
      {series.map((s) => <button type="button" data-f={s.id} aria-pressed="false">{s.label}</button>)}
    </div>
    <div class="shorts" id="shorts">
      {shorts.map((v, i) => {
        const s = seriesById[v.s];
        // the grid shows a small WebP thumbnail; the full poster is only used by the player
        const poster = v.video?.type === "file" ? v.video.thumb || v.video.poster
          : v.video?.type === "youtube" ? `https://i.ytimg.com/vi/${v.video.id}/mqdefault.jpg` : undefined;
        return (
          <button type="button" class={poster ? "short has-poster" : "short"} data-i={i} data-s={v.s}
            style={`--wire:var(--${s.color})`} aria-label={`شاهد: ${v.title}`}>
            {poster && <img class="short-poster" src={poster.startsWith("http") ? poster : url(poster)} alt="" loading="lazy" decoding="async" width="360" height="640" />}
            <span class="series">{s.label}</span>
            {!poster && <span class="glyph">{v.glyph}</span>}
            <span>
              <h3>{v.title}</h3>
              <span class="meta">{v.video ? <span>{v.dur}</span> : <span class="soon-label">قيد الإنتاج</span>}{v.video ? <span class="play"></span> : <span class="soon-dot"></span>}</span>
            </span>
          </button>
        );
      })}
    </div>
    <div class="platforms">
      <span>تُنشر على:</span>
      {platforms.map((p) => <span class="chip">{p}</span>)}
    </div>

    <dialog class="player" id="player" aria-labelledby="plTitle">
      <div class="pl-wrap">
        <div class="pl-stage" id="plStage">
          <div class="pl-frame" id="plFrame"></div>
        </div>
        <div class="pl-info">
          <div class="pl-top">
            <span class="chip" id="plSeries"></span>
            <span class="pl-count" id="plCount"></span>
            <button type="button" class="ghost-btn" id="plClose">إغلاق ✕</button>
          </div>
          <h2 id="plTitle"></h2>
          <p class="pl-desc" id="plDesc"></p>
          <div>
            <h4 class="pl-h">في هذا الفيديو</h4>
            <ul class="pl-points" id="plPoints"></ul>
          </div>
          <a class="btn pl-lab" id="plLab" hidden></a>
          <div>
            <h4 class="pl-h">شاهده على</h4>
            <div class="tracks" id="plLinks"></div>
          </div>
          <div class="pl-steps">
            <button type="button" class="btn" id="plPrev">→ السابق</button>
            <button type="button" class="btn primary" id="plNext">التالي ←</button>
          </div>
          <p class="hint">الأسهم للتنقل · Esc للإغلاق · على الجوال اسحب الفيديو للأعلى للتالي</p>
        </div>
      </div>
    </dialog>
    <script id="shorts-data" type="application/json"
      set:html={JSON.stringify({ base: url(""), series: seriesById, items: shorts }).replace(/</g, "\\u003c")} />
  </section>

  <!-- CONTACT -->
  <section class="block" id="contact">
    <div class="sec-head">
      <span class="port">:25 smtp</span>
      <h2>تواصل</h2>
    </div>
    <div class="contact">
      <div class="contact-info">
        <p>للتعاون في محتوى تقني، أو رعاية فيديو، أو اقتراح موضوع للسلسلة القادمة.</p>
        <div class="copy-row">
          <span class="mono" id="mail">{site.email}</span>
          <button type="button" id="copyBtn">نسخ</button>
        </div>
        <div class="tracks">
          {site.socials.map((s) => <a class="chip" href={s.href} target="_blank" rel="noopener" style="text-decoration:none">{s.label}</a>)}
        </div>
      </div>
      <form class="card" id="contactForm" novalidate>
        <div class="field"><label for="cf-name">الاسم</label><input id="cf-name" name="name" type="text" placeholder="اسمك" /></div>
        <div class="field"><label for="cf-type">نوع الطلب</label>
          <select id="cf-type" name="type"><option>اقتراح موضوع فيديو</option><option>تعاون أو رعاية</option><option>سؤال تقني</option></select>
        </div>
        <div class="field"><label for="cf-msg">الرسالة</label><textarea id="cf-msg" name="msg" placeholder="مثال: أقترح فيديو يشرح الفرق بين TCP و UDP."></textarea></div>
        <button class="btn primary" type="submit">إرسال الرسالة</button>
        <p class="form-msg" id="formMsg" hidden>نموذج الإرسال لم يُربط بعد. راسلني على البريد المكتوب بجانبه.</p>
      </form>
    </div>
  </section>
</Base>

<script>
  import "../scripts/hero.js";
  import "../scripts/player.js";
</script>
